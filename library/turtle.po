#: ../../library/turtle.rst:454
msgid ""
">>> turtle.setheading(90)\n"
">>> turtle.heading()\n"
"90.0"
msgstr ""
">>> turtle.setheading(90)\n"
">>> turtle.heading()\n"
"90.0"

#: ../../library/turtle.rst:464
msgid ""
"Move the turtle to the origin, coordinates (0,0). The turtle's heading is "
"set to its start orientation, which depends on the turtle mode, "
"see :func:`mode`."
msgstr ""
"Move a tartaruga para a origem, coordenadas (0,0). A direção da tartaruga é "
"defina para sua orientação inicial, que depende do modo. Veja :func:`mode`."

#: ../../library/turtle.rst:475
msgid ""
">>> turtle.heading()\n"
"90.0\n"
">>> turtle.position()\n"
"(0.00,-10.00)\n"
">>> turtle.home()\n"
">>> turtle.position()\n"
"(0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0"
msgstr ""
">>> turtle.heading()\n"
"90.0\n"
">>> turtle.position()\n"
"(0.00,-10.00)\n"
">>> turtle.home()\n"
">>> turtle.position()\n"
"(0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0"

#: ../../library/turtle.rst:493 ../../library/turtle.rst:590
#: ../../library/turtle.rst:1576
msgid "an integer or ``None``"
msgstr "um inteiro ou ``None``"

#: ../../library/turtle.rst:495
msgid ""
"Draw a circle with the given *radius*. The center is *radius* units left of "
"the turtle; *extent*, an angle, determines which part of the circle is "
"drawn. If *extent* is not given, draw the entire circle. If *extent* is not "
"a full circle, one endpoint of the arc is the current pen position. Draw the "
"arc in counterclockwise direction if *radius* is positive, otherwise in "
"clockwise direction. Finally, the turtle's heading is changed by *extent*."
msgstr ""
"Desenha um círculo com o *radius* dado. O centro são as unidades de *radius* "
"à esquerda da tartaruga; *extent*, um ângulo, determina qual parte do "
"círculo é desenhada. Se *extent* não for fornecida, desenha o círculo "
"inteiro. Se *extent* não for um círculo completo, uma extremidade do arco "
"será a posição atual da caneta. Desenha o arco no sentido anti-horário se "
"*radius* for positivo, caso contrário, no sentido horário. Finalmente, a "
"direção da tartaruga é alterada da *extent*."

#: ../../library/turtle.rst:503
msgid ""
"As the circle is approximated by an inscribed regular polygon, *steps* "
"determines the number of steps to use. If not given, it will be calculated "
"automatically. May be used to draw regular polygons."
msgstr ""
"Como o círculo é aproximado por um polígono regular inscrito, *steps* "
"determina o número de passos a serem usados. Caso não seja informado, será "
"calculado automaticamente. Pode ser usado para desenhar polígonos regulares."

#: ../../library/turtle.rst:507
msgid ""
">>> turtle.home()\n"
">>> turtle.position()\n"
"(0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0\n"
">>> turtle.circle(50)\n"
">>> turtle.position()\n"
"(-0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0\n"
">>> turtle.circle(120, 180)  # draw a semicircle\n"
">>> turtle.position()\n"
"(0.00,240.00)\n"
">>> turtle.heading()\n"
"180.0"
msgstr ""
">>> turtle.home()\n"
">>> turtle.position()\n"
"(0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0\n"
">>> turtle.circle(50)\n"
">>> turtle.position()\n"
"(-0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0\n"
">>> turtle.circle(120, 180)  # draw a semicircle\n"
">>> turtle.position()\n"
"(0.00,240.00)\n"
">>> turtle.heading()\n"
"180.0"

#: ../../library/turtle.rst:533 ../../library/turtle.rst:1707
#: ../../library/turtle.rst:1708
msgid "a positive integer or ``None``"
msgstr ""

#: ../../library/turtle.rst:534
msgid "a colorstring or a numeric color tuple"
msgstr "uma string de cores ou uma tupla de cores numéricas"

#: ../../library/turtle.rst:536
msgid ""
"Draw a circular dot with diameter *size*, using *color*. If *size* is not "
"given, the larger of ``pensize + 4`` and ``2 * pensize`` is used. If *color* "
"is not given, the current pencolor is used."
msgstr ""

#: ../../library/turtle.rst:540
msgid ""
">>> turtle.home()\n"
">>> turtle.dot()\n"
">>> turtle.fd(50); turtle.dot(20, \"blue\"); turtle.fd(50)\n"
">>> turtle.position()\n"
"(100.00,-0.00)\n"
">>> turtle.heading()\n"
"0.0"
msgstr ""
">>> turtle.home()\n"
">>> turtle.dot()\n"
">>> turtle.fd(50); turtle.dot(20, \"blue\"); turtle.fd(50)\n"
">>> turtle.position()\n"
"(100.00,-0.00)\n"
">>> turtle.heading()\n"
"0.0"

#: ../../library/turtle.rst:554
msgid ""
"Stamp a copy of the turtle shape onto the canvas and return its id. The "
"stamp is placed at the current turtle position. The returned id can be used "
"to delete the stamp with :func:`clearstamp`."
msgstr ""

#: ../../library/turtle.rst:558
msgid ""
">>> turtle.color(\"blue\")\n"
">>> stamp_id = turtle.stamp()\n"
">>> turtle.fd(50)"
msgstr ""
">>> turtle.color(\"blue\")\n"
">>> stamp_id = turtle.stamp()\n"
">>> turtle.fd(50)"

#: ../../library/turtle.rst:568 ../../library/turtle.rst:1401
#: ../../library/turtle.rst:1901
msgid "an integer"
msgstr ""

#: ../../library/turtle.rst:570
msgid ""
"Delete the stamp with the given *stampid*. *stampid* must be the return "
"value of a previous :func:`stamp` call."
msgstr ""

#: ../../library/turtle.rst:573
msgid ""
">>> turtle.position()\n"
"(150.00,-0.00)\n"
">>> turtle.color(\"blue\")\n"
">>> astamp = turtle.stamp()\n"
">>> turtle.fd(50)\n"
">>> turtle.position()\n"
"(200.00,-0.00)\n"
">>> turtle.clearstamp(astamp)\n"
">>> turtle.position()\n"
"(200.00,-0.00)"
msgstr ""
">>> turtle.position()\n"
"(150.00,-0.00)\n"
">>> turtle.color(\"blue\")\n"
">>> astamp = turtle.stamp()\n"
">>> turtle.fd(50)\n"
">>> turtle.position()\n"
"(200.00,-0.00)\n"
">>> turtle.clearstamp(astamp)\n"
">>> turtle.position()\n"
"(200.00,-0.00)"

#: ../../library/turtle.rst:592
msgid ""
"Delete all or the first or last *n* of the turtle's stamps. If *n* is not "
"given, delete all stamps. If *n* is positive, delete the first *n* stamps. "
"If *n* is negative, delete the last *n* stamps, so -2 deletes the last two."
msgstr ""

#: ../../library/turtle.rst:596
msgid ""
">>> for i in range(8):\n"
"...     unused_stamp_id = turtle.stamp()\n"
"...     turtle.fd(30)\n"
">>> turtle.clearstamps(2)\n"
">>> turtle.clearstamps(-2)\n"
">>> turtle.clearstamps()"
msgstr ""
">>> for i in range(8):\n"
"...     unused_stamp_id = turtle.stamp()\n"
"...     turtle.fd(30)\n"
">>> turtle.clearstamps(2)\n"
">>> turtle.clearstamps(-2)\n"
">>> turtle.clearstamps()"

#: ../../library/turtle.rst:609
msgid ""
"Undo (repeatedly) the last turtle action(s).  Number of available undo "
"actions is determined by the size of the undobuffer."
msgstr ""
"Desfaz (repetidamente) a(s) última(s) ação(ões) da tartaruga. O número de "
"ações de desfazer disponíveis é determinado pelo tamanho do buffer de "
"desfazer."

#: ../../library/turtle.rst:612
msgid ""
">>> for i in range(4):\n"
"...     turtle.fd(50); turtle.lt(80)\n"
"...\n"
">>> for i in range(8):\n"
"...     turtle.undo()"
msgstr ""
">>> for i in range(4):\n"
"...     turtle.fd(50); turtle.lt(80)\n"
"...\n"
">>> for i in range(8):\n"
"...     turtle.undo()"

#: ../../library/turtle.rst:624
msgid "an integer, a string or ``None``"
msgstr ""

#: ../../library/turtle.rst:626
msgid ""
"Return or set the turtle's speed. If *speed* is not given, return the "
"current speed. Otherwise set the turtle's speed to an integer from 0 to 10. "
"If *speed* is a number greater than 10 or smaller than 0.5, the speed is set "
"to 0. You can also use these names instead of numbers:"
msgstr ""

#: ../../library/turtle.rst:631
msgid "\"fastest\": 0"
msgstr ""

#: ../../library/turtle.rst:632
msgid "\"fast\": 10"
msgstr ""

#: ../../library/turtle.rst:633
msgid "\"normal\": 6"
msgstr ""

#: ../../library/turtle.rst:634
msgid "\"slow\": 3"
msgstr ""

#: ../../library/turtle.rst:635
msgid "\"slowest\": 1"
msgstr ""

#: ../../library/turtle.rst:637
msgid ""
"Speeds from 1 to 10 give increasingly faster animation of line drawing and "
"turtle turning. A speed of 0 means that no animation takes "
"place: :func:`forward` and :func:`back` make the turtle jump, and "
"likewise :func:`left` and :func:`right` make the turtle turn instantly."
msgstr ""

#: ../../library/turtle.rst:642
msgid ""
">>> turtle.speed()\n"
"3\n"
">>> turtle.speed('normal')\n"
">>> turtle.speed()\n"
"6\n"
">>> turtle.speed(9)\n"
">>> turtle.speed()\n"
"9"
msgstr ""
">>> turtle.speed()\n"
"3\n"
">>> turtle.speed('normal')\n"
">>> turtle.speed()\n"
"6\n"
">>> turtle.speed(9)\n"
">>> turtle.speed()\n"
"9"

#: ../../library/turtle.rst:656
msgid "Tell Turtle's state"
msgstr "Fala o estado de Turtle"

#: ../../library/turtle.rst:661
msgid "Return the turtle's current location (x,y) as a :class:`Vec2D` vector."
msgstr ""
"Retorna a localização atual da tartaruga (x,y) como um vetor :class:`Vec2D`."

#: ../../library/turtle.rst:663
msgid ""
">>> turtle.pos()\n"
"(440.00,-0.00)"
msgstr ""
">>> turtle.pos()\n"
"(440.00,-0.00)"

#: ../../library/turtle.rst:672 ../../library/turtle.rst:737
msgid "a number or a pair/vector of numbers or a turtle instance"
msgstr "um número ou um par/vetor de números ou uma instância de tartaruga"

#: ../../library/turtle.rst:673 ../../library/turtle.rst:738
msgid "a number if *x* is a number, else ``None``"
msgstr "um número caso *x* seja um número, senão ``None``"

#: ../../library/turtle.rst:675
msgid ""
"Return the angle of the line from the turtle's position to (x,y). If *y* is "
"``None``, *x* must be a pair of coordinates, a :class:`Vec2D`, for example "
"as returned by :func:`pos`, or another turtle. The angle is measured from "
"the turtle's start orientation, which depends on the turtle mode, "
"see :func:`mode`."
msgstr ""
"Retorna o ângulo da linha que vai da posição da tartaruga até (x,y). Se *y* "
"for ``None``, *x* deve ser um par de coordenadas — um :class:`Vec2D`, por "
"exemplo, como o retornado por :func:`pos` — ou outra tartaruga. O ângulo é "
"medido a partir da orientação inicial da tartaruga, a qual depende do modo "
"da tartaruga; consulte :func:`mode`."

#: ../../library/turtle.rst:681
msgid ""
">>> turtle.goto(10, 10)\n"
">>> turtle.towards(0,0)\n"
"225.0"
msgstr ""
">>> turtle.goto(10, 10)\n"
">>> turtle.towards(0,0)\n"
"225.0"

#: ../../library/turtle.rst:691
msgid "Return the turtle's x coordinate."
msgstr "Retorna a coordenada X da tartaruga."

#: ../../library/turtle.rst:693
msgid ""
">>> turtle.home()\n"
">>> turtle.left(50)\n"
">>> turtle.forward(100)\n"
">>> turtle.pos()\n"
"(64.28,76.60)\n"
">>> print(round(turtle.xcor(), 5))\n"
"64.27876"
msgstr ""
">>> turtle.home()\n"
">>> turtle.left(50)\n"
">>> turtle.forward(100)\n"
">>> turtle.pos()\n"
"(64.28,76.60)\n"
">>> print(round(turtle.xcor(), 5))\n"
"64.27876"

#: ../../library/turtle.rst:707
msgid "Return the turtle's y coordinate."
msgstr "Retorna a coordenada Y da tartaruga."

#: ../../library/turtle.rst:709
msgid ""
">>> turtle.home()\n"
">>> turtle.left(60)\n"
">>> turtle.forward(100)\n"
">>> print(turtle.pos())\n"
"(50.00,86.60)\n"
">>> print(round(turtle.ycor(), 5))\n"
"86.60254"
msgstr ""
">>> turtle.home()\n"
">>> turtle.left(60)\n"
">>> turtle.forward(100)\n"
">>> print(turtle.pos())\n"
"(50.00,86.60)\n"
">>> print(round(turtle.ycor(), 5))\n"
"86.60254"

#: ../../library/turtle.rst:723
msgid ""
"Return the turtle's current heading. The value depends on the turtle mode, "
"see :func:`mode`."
msgstr ""
"Retorna o título atual da tartaruga. O valor depende do modo da tartaruga, "
"veja :func:`mode`."

#: ../../library/turtle.rst:726
msgid ""
">>> turtle.home()\n"
">>> turtle.left(67)\n"
">>> turtle.heading()\n"
"67.0"
msgstr ""
">>> turtle.home()\n"
">>> turtle.left(67)\n"
">>> turtle.heading()\n"
"67.0"

#: ../../library/turtle.rst:740
msgid ""
"Return the distance from the turtle to (x,y) in turtle step units. If *y* is "
"``None``, *x* must be a pair of coordinates, a :class:`Vec2D`, for example "
"as returned by :func:`pos`, or another turtle."
msgstr ""
"Retorna a distância da tartaruga para (x,y) em unidades de passo de "
"tartaruga. Se *y* for ``None``, *x* deve ser um par de coordenadas ou "
"um :class:`Vec2D`, como, por exemplo, o valor retornado por :func:`pos` ou "
"outra tartaruga."

#: ../../library/turtle.rst:744
msgid ""
">>> turtle.home()\n"
">>> turtle.distance(30,40)\n"
"50.0\n"
">>> turtle.distance((30,40))\n"
"50.0\n"
">>> joe = Turtle()\n"
">>> joe.forward(77)\n"
">>> turtle.distance(joe)\n"
"77.0"
msgstr ""
">>> turtle.home()\n"
">>> turtle.distance(30,40)\n"
"50.0\n"
">>> turtle.distance((30,40))\n"
"50.0\n"
">>> joe = Turtle()\n"
">>> joe.forward(77)\n"
">>> turtle.distance(joe)\n"
"77.0"

#: ../../library/turtle.rst:759
msgid "Settings for measurement"
msgstr "Configurações de medida"

#: ../../library/turtle.rst:765
msgid ""
"Set the angle measurement units to degrees. The number of degrees in a full "
"circle is set to *fullcircle*, which defaults to 360."
msgstr ""
"Define as unidades de medida de ângulo como graus. O número de graus em um "
"círculo completo é definido como *fullcircle*, cujo valor padrão é 360."

#: ../../library/turtle.rst:768
msgid ""
">>> turtle.home()\n"
">>> turtle.left(90)\n"
">>> turtle.heading()\n"
"90.0\n"
"\n"
">>> # Change angle measurement unit to grad (also known as gon,\n"
">>> # grade, or gradian and equals 1/100-th of the right angle.)\n"
">>> turtle.degrees(400.0)\n"
">>> turtle.heading()\n"
"100.0\n"
">>> turtle.degrees(360)\n"
">>> turtle.heading()\n"
"90.0"
msgstr ""
">>> turtle.home()\n"
">>> turtle.left(90)\n"
">>> turtle.heading()\n"
"90.0\n"
"\n"
">>> # Alterar unidade de medida de ângulo para grad (também\n"
">>> # conhecido como gon, grau ou grado e é igual a 1/100\n"
">>> # do ângulo reto).\n"
">>> turtle.degrees(400.0)\n"
">>> turtle.heading()\n"
"100.0\n"
">>> turtle.degrees(360)\n"
">>> turtle.heading()\n"
"90.0"

#: ../../library/turtle.rst:788
msgid ""
"Set the angle measurement units to radians.  Equivalent to ``degrees(2 * "
"math.pi)``."
msgstr ""
"Define as unidades de medida de ângulo para radianos. Equivalente a "
"``degrees(2 * math.pi)``."

#: ../../library/turtle.rst:791
msgid ""
">>> turtle.home()\n"
">>> turtle.left(90)\n"
">>> turtle.heading()\n"
"90.0\n"
">>> turtle.radians()\n"
">>> turtle.heading()\n"
"1.5707963267948966"
msgstr ""
">>> turtle.home()\n"
">>> turtle.left(90)\n"
">>> turtle.heading()\n"
"90.0\n"
">>> turtle.radians()\n"
">>> turtle.heading()\n"
"1.5707963267948966"

#: ../../library/turtle.rst:813
msgid "Drawing state"
msgstr "Estado do Desenho"

#: ../../library/turtle.rst:819
msgid "Lower the pen. The turtle draws a line when it moves."
msgstr ""

#: ../../library/turtle.rst:826
msgid "Lift the pen. The turtle does not draw when it moves."
msgstr ""

#: ../../library/turtle.rst:832 ../../library/turtle.rst:1256
#: ../../library/turtle.rst:1257 ../../library/turtle.rst:1258
msgid "a positive number or ``None``"
msgstr ""

#: ../../library/turtle.rst:834
msgid ""
"Return or set the line thickness. If *width* is not given, return the "
"current pensize. If resizemode is set to \"auto\" and the turtle shape is a "
"polygon, that polygon is drawn with the same line thickness."
msgstr ""

#: ../../library/turtle.rst:838
msgid ""
">>> turtle.pensize()\n"
"1\n"
">>> turtle.pensize(10)   # from here on lines of width 10 are drawn"
msgstr ""
">>> turtle.pensize()\n"
"1\n"
">>> turtle.pensize(10)   # from here on lines of width 10 are drawn"

#: ../../library/turtle.rst:848
msgid "a dictionary or ``None``"
msgstr ""

#: ../../library/turtle.rst:849
msgid "keyword arguments with the keys below"
msgstr ""

#: ../../library/turtle.rst:851
msgid ""
"Return or set the pen's attributes. The attributes are returned as a "
"dictionary with the following keys and values:"
msgstr ""

#: ../../library/turtle.rst:854
msgid "\"shown\": ``True`` or ``False``"
msgstr ""

#: ../../library/turtle.rst:855
msgid "\"pendown\": ``True`` or ``False``"
msgstr ""

#: ../../library/turtle.rst:856
msgid "\"pencolor\": a color string or a color tuple"
msgstr ""

#: ../../library/turtle.rst:857
msgid "\"fillcolor\": a color string or a color tuple"
msgstr ""

#: ../../library/turtle.rst:858
msgid "\"pensize\": a positive number"
msgstr ""

#: ../../library/turtle.rst:859
msgid "\"speed\": a number from 0 to 10"
msgstr ""

#: ../../library/turtle.rst:860
msgid "\"resizemode\": \"auto\", \"user\" or \"noresize\""
msgstr ""

#: ../../library/turtle.rst:861
msgid "\"stretchfactor\": a pair of positive numbers"
msgstr ""

#: ../../library/turtle.rst:862
msgid "\"shearfactor\": a number"
msgstr ""

#: ../../library/turtle.rst:863
msgid "\"outline\": a positive number"
msgstr ""

#: ../../library/turtle.rst:864
msgid "\"tilt\": a number"
msgstr ""

#: ../../library/turtle.rst:866
msgid ""
"Such a dictionary can be passed as *pen* to restore a former pen state. The "
"attributes can also be given as keyword arguments, which can be used to set "
"several of them in one statement."
msgstr ""

#: ../../library/turtle.rst:870
msgid ""
">>> turtle.pen(fillcolor=\"black\", pencolor=\"red\", pensize=10)\n"
">>> turtle.pen()\n"
"{'shown': True, 'pendown': True, 'pencolor': 'red', 'fillcolor': 'black',\n"
" 'pensize': 10, 'speed': 9, 'resizemode': 'noresize',\n"
" 'stretchfactor': (1.0, 1.0), 'shearfactor': 0.0, 'outline': 1,\n"
" 'tilt': 0.0}\n"
">>> penstate = turtle.pen()\n"
">>> turtle.color(\"yellow\", \"\")\n"
">>> turtle.penup()\n"
">>> turtle.pen()[\"pencolor\"]\n"
"'yellow'\n"
">>> # restore the saved pen state, but with a green fill\n"
">>> turtle.pen(penstate, fillcolor=\"green\")\n"
">>> turtle.pen()[\"pencolor\"]\n"
"'red'\n"
">>> turtle.pen()[\"fillcolor\"]\n"
"'green'"
msgstr ""

#: ../../library/turtle.rst:894
msgid "Return ``True`` if the pen is down, ``False`` if it's up."
msgstr ""

#: ../../library/turtle.rst:896
msgid ""
">>> turtle.penup()\n"
">>> turtle.isdown()\n"
"False\n"
">>> turtle.pendown()\n"
">>> turtle.isdown()\n"
"True"
msgstr ""
">>> turtle.penup()\n"
">>> turtle.isdown()\n"
"False\n"
">>> turtle.pendown()\n"
">>> turtle.isdown()\n"
"True"

#: ../../library/turtle.rst:908
msgid "Color control"
msgstr "Controle da Cor"

#: ../../library/turtle.rst:914
msgid "Return or set the pencolor."
msgstr "Retorna ou define a cor da caneta ou pencolor."

#: ../../library/turtle.rst:916 ../../library/turtle.rst:968
#: ../../library/turtle.rst:1625
msgid "Four input formats are allowed:"
msgstr "São permitidos quatro formatos de entrada:"

#: ../../library/turtle.rst:918
msgid "``pencolor()``"
msgstr "``pencolor()``"

#: ../../library/turtle.rst:919
msgid ""
"Return the current pencolor as color specification string or as a tuple (see "
"example).  May be used as input to "
"another :func:`color`, :func:`pencolor`, :func:`fillcolor` "
"or :func:`bgcolor` call."
msgstr ""

#: ../../library/turtle.rst:924
msgid "``pencolor(colorstring)``"
msgstr "``pencolor(colorstring)``"

#: ../../library/turtle.rst:925
msgid ""
"Set the pencolor to *colorstring*, which is a Tk color specification string, "
"such as ``\"red\"``, ``\"yellow\"``, or ``\"#33cc8c\"``."
msgstr ""

#: ../../library/turtle.rst:928
msgid "``pencolor((r, g, b))``"
msgstr "``pencolor((r, g, b))``"

#: ../../library/turtle.rst:929
msgid ""
"Set the pencolor to the RGB color represented by the tuple of *r*, *g*, and "
"*b*. Each of *r*, *g*, and *b* must be between 0 and colormode, where "
"colormode is either 1.0 or 255 (see :func:`colormode`)."
msgstr ""

#: ../../library/turtle.rst:933
msgid "``pencolor(r, g, b)``"
msgstr "``pencolor(r, g, b)``"

#: ../../library/turtle.rst:934
msgid ""
"Set the pencolor to the RGB color represented by *r*, *g*, and *b*. Each of "
"*r*, *g*, and *b* must be between 0 and colormode."
msgstr ""

#: ../../library/turtle.rst:937
msgid ""
"If the turtle shape is a polygon, the outline of that polygon is drawn with "
"the newly set pencolor."
msgstr ""

#: ../../library/turtle.rst:940
msgid ""
">>> colormode()\n"
"1.0\n"
">>> turtle.pencolor()\n"
"'red'\n"
">>> turtle.pencolor(\"brown\")\n"
">>> turtle.pencolor()\n"
"'brown'\n"
">>> tup = (0.2, 0.8, 0.55)\n"
">>> turtle.pencolor(tup)\n"
">>> turtle.pencolor()\n"
"(0.2, 0.8, 0.5490196078431373)\n"
">>> colormode(255)\n"
">>> turtle.pencolor()\n"
"(51.0, 204.0, 140.0)\n"
">>> turtle.pencolor('#32c18f')\n"
">>> turtle.pencolor()\n"
"(50.0, 193.0, 143.0)"
msgstr ""
">>> colormode()\n"
"1.0\n"
">>> turtle.pencolor()\n"
"'red'\n"
">>> turtle.pencolor(\"brown\")\n"
">>> turtle.pencolor()\n"
"'brown'\n"
">>> tup = (0.2, 0.8, 0.55)\n"
">>> turtle.pencolor(tup)\n"
">>> turtle.pencolor()\n"
"(0.2, 0.8, 0.5490196078431373)\n"
">>> colormode(255)\n"
">>> turtle.pencolor()\n"
"(51.0, 204.0, 140.0)\n"
">>> turtle.pencolor('#32c18f')\n"
">>> turtle.pencolor()\n"
"(50.0, 193.0, 143.0)"

#: ../../library/turtle.rst:966
msgid "Return or set the fillcolor."
msgstr "Retorna ou define o fillcolor."

#: ../../library/turtle.rst:970
msgid "``fillcolor()``"
msgstr "``fillcolor()``"

#: ../../library/turtle.rst:971
msgid ""
"Return the current fillcolor as color specification string, possibly in "
"tuple format (see example).  May be used as input to "
"another :func:`color`, :func:`pencolor`, :func:`fillcolor` "
"or :func:`bgcolor` call."
msgstr ""

#: ../../library/turtle.rst:976
msgid "``fillcolor(colorstring)``"
msgstr "``fillcolor(colorstring)``"

#: ../../library/turtle.rst:977
msgid ""
"Set the fillcolor to *colorstring*, which is a Tk color specification "
"string, such as ``\"red\"``, ``\"yellow\"``, or ``\"#33cc8c\"``."
msgstr ""

#: ../../library/turtle.rst:980
msgid "``fillcolor((r, g, b))``"
msgstr "``fillcolor((r, g, b))``"

#: ../../library/turtle.rst:981
msgid ""
"Set the fillcolor to the RGB color represented by the tuple of *r*, *g*, and "
"*b*. Each of *r*, *g*, and *b* must be between 0 and colormode, where "
"colormode is either 1.0 or 255 (see :func:`colormode`)."
msgstr ""

#: ../../library/turtle.rst:985
msgid "``fillcolor(r, g, b)``"
msgstr "``fillcolor(r, g, b)``"

#: ../../library/turtle.rst:986
msgid ""
"Set the fillcolor to the RGB color represented by *r*, *g*, and *b*. Each of "
"*r*, *g*, and *b* must be between 0 and colormode."
msgstr ""

#: ../../library/turtle.rst:989
msgid ""
"If the turtle shape is a polygon, the interior of that polygon is drawn with "
"the newly set fillcolor."
msgstr ""

#: ../../library/turtle.rst:992
msgid ""
">>> turtle.fillcolor(\"violet\")\n"
">>> turtle.fillcolor()\n"
"'violet'\n"
">>> turtle.pencolor()\n"
"(50.0, 193.0, 143.0)\n"
">>> turtle.fillcolor((50, 193, 143))  # Integers, not floats\n"
">>> turtle.fillcolor()\n"
"(50.0, 193.0, 143.0)\n"
">>> turtle.fillcolor('#ffffff')\n"
">>> turtle.fillcolor()\n"
"(255.0, 255.0, 255.0)"
msgstr ""
">>> turtle.fillcolor(\"violet\")\n"
">>> turtle.fillcolor()\n"
"'violet'\n"
">>> turtle.pencolor()\n"
"(50.0, 193.0, 143.0)\n"
">>> turtle.fillcolor((50, 193, 143))  # Inteiros, não pontos flutuantes\n"
">>> turtle.fillcolor()\n"
"(50.0, 193.0, 143.0)\n"
">>> turtle.fillcolor('#ffffff')\n"
">>> turtle.fillcolor()\n"
"(255.0, 255.0, 255.0)"

#: ../../library/turtle.rst:1013
msgid "Return or set the pencolor and fillcolor."
msgstr ""

#: ../../library/turtle.rst:1015
msgid ""
"Several input formats are allowed. They use 0 to 3 arguments as follows:"
msgstr ""

#: ../../library/turtle.rst:1018
msgid "``color()``"
msgstr "``color()``"

#: ../../library/turtle.rst:1019
msgid ""
"Return the current pencolor and the current fillcolor as a pair of color "
"specification strings or tuples as returned by :func:`pencolor` "
"and :func:`fillcolor`."
msgstr ""
"Retorna os valores atuais de pencolor e fillcollor como um par de cores como "
"strings ou tuplas conforme retornado por :func:`pencolor` "
"e :func:`fillcolor`."

#: ../../library/turtle.rst:1023
msgid "``color(colorstring)``, ``color((r,g,b))``, ``color(r,g,b)``"
msgstr "``color(colorstring)``, ``color((r,g,b))``, ``color(r,g,b)``"

#: ../../library/turtle.rst:1024
msgid ""
"Inputs as in :func:`pencolor`. Set both the pencolor and the fillcolor to "
"the given value."
msgstr ""

#: ../../library/turtle.rst:1027
msgid ""
"``color(colorstring1, colorstring2)``, ``color((r1,g1,b1), (r2,g2,b2))``"
msgstr ""
"``color(colorstring1, colorstring2)``, ``color((r1,g1,b1), (r2,g2,b2))``"

#: ../../library/turtle.rst:1028
msgid ""
"Equivalent to ``pencolor(colorstring1)`` and ``fillcolor(colorstring2)`` and "
"analogously if the other input format is used."
msgstr ""
"Equivalente a ``pencolor(colorstring1)`` e ``fillcolor(colorstring2)`` e de "
"forma análoga se a outra formatação de entrada for usada."

#: ../../library/turtle.rst:1031
msgid ""
"If the turtle shape is a polygon, the outline and interior of that polygon "
"are drawn with the newly set colors."
msgstr ""

#: ../../library/turtle.rst:1034
msgid ""
">>> turtle.color(\"red\", \"green\")\n"
">>> turtle.color()\n"
"('red', 'green')\n"
">>> color(\"#285078\", \"#a0c8f0\")\n"
">>> color()\n"
"((40.0, 80.0, 120.0), (160.0, 200.0, 240.0))"
msgstr ""
">>> turtle.color(\"red\", \"green\")\n"
">>> turtle.color()\n"
"('red', 'green')\n"
">>> color(\"#285078\", \"#a0c8f0\")\n"
">>> color()\n"
"((40.0, 80.0, 120.0), (160.0, 200.0, 240.0))"

#: ../../library/turtle.rst:1045
msgid "See also: Screen method :func:`colormode`."
msgstr "Veja também: Método da tela :func:`colormode`."

#: ../../library/turtle.rst:1049
msgid "Filling"
msgstr "Preenchimento"

#: ../../library/turtle.rst:1060
msgid "Return ``True`` if the turtle is filling, ``False`` otherwise."
msgstr ""

#: ../../library/turtle.rst:1062
msgid ""
">>> turtle.begin_fill()\n"
">>> if turtle.filling():\n"
"...    turtle.pensize(5)\n"
"... else:\n"
"...    turtle.pensize(3)"
msgstr ""
">>> turtle.begin_fill()\n"
">>> if turtle.filling():\n"
"...    turtle.pensize(5)\n"
"... else:\n"
"...    turtle.pensize(3)"

#: ../../library/turtle.rst:1074
msgid "Fill the shape drawn in the :keyword:`with` block."
msgstr ""

#: ../../library/turtle.rst:1076
msgid ""
">>> turtle.color(\"black\", \"red\")\n"
">>> with turtle.fill():\n"
"...     turtle.circle(80)"
msgstr ""
">>> turtle.color(\"black\", \"red\")\n"
">>> with turtle.fill():\n"
"...     turtle.circle(80)"

#: ../../library/turtle.rst:1083
msgid ""
":func:`fill` is a :term:`context manager`, so using it is the same as "
"calling :func:`begin_fill` before the block and :func:`end_fill` after it:"
msgstr ""

#: ../../library/turtle.rst:1086 ../../library/turtle.rst:1112
msgid ""
">>> turtle.color(\"black\", \"red\")\n"
">>> turtle.begin_fill()\n"
">>> turtle.circle(80)\n"
">>> turtle.end_fill()"
msgstr ""
">>> turtle.color(\"black\", \"red\")\n"
">>> turtle.begin_fill()\n"
">>> turtle.circle(80)\n"
">>> turtle.end_fill()"

#: ../../library/turtle.rst:1099
msgid ""
"Call just before drawing a shape to be filled. The shape is filled by the "
"next call to :func:`end_fill`."
msgstr ""

#: ../../library/turtle.rst:1105
msgid "Fill the shape drawn after the last call to :func:`begin_fill`."
msgstr ""
"Preenche a forma desenhada após a última chamada para :func:`begin_fill`."

#: ../../library/turtle.rst:1107
msgid ""
"If the shape crosses itself or several shapes overlap, whether the "
"overlapping parts are filled depends on the operating system, the type of "
"overlap and how many there are. For example, the turtle star above may be "
"either all yellow or have some white regions."
msgstr ""

#: ../../library/turtle.rst:1122
msgid "More drawing control"
msgstr "Mais sobre o Controle do Desenho"

#: ../../library/turtle.rst:1126
msgid ""
"Delete the turtle's drawings and re-center the turtle. The turtle's settings "
"are restored to their default values."
msgstr ""

#: ../../library/turtle.rst:1129
msgid ""
">>> turtle.goto(0,-22)\n"
">>> turtle.left(100)\n"
">>> turtle.position()\n"
"(0.00,-22.00)\n"
">>> turtle.heading()\n"
"100.0\n"
">>> turtle.reset()\n"
">>> turtle.position()\n"
"(0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0"
msgstr ""
">>> turtle.goto(0,-22)\n"
">>> turtle.left(100)\n"
">>> turtle.position()\n"
"(0.00,-22.00)\n"
">>> turtle.heading()\n"
"100.0\n"
">>> turtle.reset()\n"
">>> turtle.position()\n"
"(0.00,0.00)\n"
">>> turtle.heading()\n"
"0.0"

#: ../../library/turtle.rst:1147
msgid ""
"Delete the turtle's drawings from the screen. The state and position of the "
"turtle as well as the drawings of other turtles are not affected."
msgstr ""

#: ../../library/turtle.rst:1153
msgid "an object"
msgstr ""

#: ../../library/turtle.rst:1155 ../../library/turtle.rst:1851
#: ../../library/turtle.rst:1960 ../../library/turtle.rst:1961
#: ../../library/turtle.rst:1972 ../../library/turtle.rst:1973
#: ../../library/turtle.rst:2070 ../../library/turtle.rst:2159
#: ../../library/turtle.rst:2205 ../../library/turtle.rst:2261
msgid "a string"
msgstr "uma string"

#: ../../library/turtle.rst:1156
msgid "a tuple of a string, an integer and a string"
msgstr ""

#: ../../library/turtle.rst:1158
msgid ""
"Write text at the current turtle position. The text is the string "
"representation of *arg*. *align* is one of the strings \"left\", \"center\" "
"or \"right\" and says how the text is placed relative to the turtle "
"position. *font* is a triple of font name, font size and font type. If "
"*move* is ``True``, the pen is moved to the bottom-right corner of the text."
msgstr ""

#: ../../library/turtle.rst:1164
msgid ""
">>> turtle.write(\"Home = \", True, align=\"center\")\n"
">>> turtle.write((0,0), True)"
msgstr ""
">>> turtle.write(\"Home = \", True, align=\"center\")\n"
">>> turtle.write((0,0), True)"

#: ../../library/turtle.rst:1172
msgid "Turtle state"
msgstr "Estado da tartaruga"

#: ../../library/turtle.rst:1175
msgid "Visibility"
msgstr "Visibilidade"

#: ../../library/turtle.rst:1180
msgid "Make the turtle invisible. If the pen is down, movement still draws."
msgstr ""

#: ../../library/turtle.rst:1186
msgid "Make the turtle visible."
msgstr "Tornar a tartaruga visível."

#: ../../library/turtle.rst:1191
msgid "Return ``True`` if the turtle is visible, ``False`` if it's hidden."
msgstr ""

#: ../../library/turtle.rst:1193
msgid ""
">>> turtle.hideturtle()\n"
">>> turtle.isvisible()\n"
"False\n"
">>> turtle.showturtle()\n"
">>> turtle.isvisible()\n"
"True"
msgstr ""
">>> turtle.hideturtle()\n"
">>> turtle.isvisible()\n"
"False\n"
">>> turtle.showturtle()\n"
">>> turtle.isvisible()\n"
"True"

#: ../../library/turtle.rst:1205
msgid "Appearance"
msgstr "Aparência"

#: ../../library/turtle.rst:1209 ../../library/turtle.rst:1229
#: ../../library/turtle.rst:1660 ../../library/turtle.rst:1875
#: ../../library/turtle.rst:1994
msgid "a string or ``None``"
msgstr ""

#: ../../library/turtle.rst:1211
msgid ""
"Set the turtle shape to the named shape. If *name* is not given, return the "
"name of the current shape. The shape must exist in "
"the :class:`TurtleScreen`'s shape dictionary. Initially there are the "
"following shapes: \"arrow\", \"turtle\", \"circle\", \"square\", "
"\"triangle\" and \"classic\". To add shapes, see the :class:`Screen` "
"method :func:`register_shape`."
msgstr ""

#: ../../library/turtle.rst:1217
msgid ""
">>> turtle.shape()\n"
"'classic'\n"
">>> turtle.shape(\"turtle\")\n"
">>> turtle.shape()\n"
"'turtle'"
msgstr ""
">>> turtle.shape()\n"
"'classic'\n"
">>> turtle.shape(\"turtle\")\n"
">>> turtle.shape()\n"
"'turtle'"

#: ../../library/turtle.rst:1231
msgid ""
"Set the resizemode to \"auto\", \"user\" or \"noresize\". If *rmode* is not "
"given, return the current resizemode. The different resizemodes have the "
"following effects:"
msgstr ""

#: ../../library/turtle.rst:1235
msgid ""
"\"auto\": the turtle is resized according to the value of :func:`pensize`."
msgstr ""

#: ../../library/turtle.rst:1236
msgid ""
"\"user\": the turtle is resized according to the stretch factors and outline "
"width, which are set by :func:`shapesize`."
msgstr ""

#: ../../library/turtle.rst:1238
msgid "\"noresize\": the turtle is not resized."
msgstr ""

#: ../../library/turtle.rst:1240
msgid ""
"``resizemode(\"user\")`` is called by :func:`shapesize` when used with "
"arguments."
msgstr ""
"``resizemode(\"user\")`` é chamado por :func:`shapesize` quando usado com "
"argumentos."

#: ../../library/turtle.rst:1243
msgid ""
">>> turtle.resizemode()\n"
"'noresize'\n"
">>> turtle.resizemode(\"auto\")\n"
">>> turtle.resizemode()\n"
"'auto'"
msgstr ""
">>> turtle.resizemode()\n"
"'noresize'\n"
">>> turtle.resizemode(\"auto\")\n"
">>> turtle.resizemode()\n"
"'auto'"

#: ../../library/turtle.rst:1260
msgid ""
"Return or set the turtle's stretch factors and outline width. If no "
"arguments are given, return the current values. Otherwise set resizemode to "
"\"user\", so that the turtle is displayed stretched according to its stretch "
"factors:"
msgstr ""

#: ../../library/turtle.rst:1265
msgid "*stretch_wid*: the stretch factor perpendicular to the turtle's heading"
msgstr ""

#: ../../library/turtle.rst:1266
msgid ""
"*stretch_len*: the stretch factor in the direction of the turtle's heading"
msgstr ""

#: ../../library/turtle.rst:1268
msgid "*outline*: the width of the shape's outline"
msgstr ""

#: ../../library/turtle.rst:1270
msgid ""
"For example, ``shapesize(2, 1)`` makes the turtle twice as wide without "
"changing its length. If only *stretch_wid* is given, *stretch_len* is set to "
"the same value."
msgstr ""

#: ../../library/turtle.rst:1274
msgid ""
">>> turtle.shapesize()\n"
"(1.0, 1.0, 1)\n"
">>> turtle.resizemode(\"user\")\n"
">>> turtle.shapesize(5, 5, 12)\n"
">>> turtle.shapesize()\n"
"(5, 5, 12)\n"
">>> turtle.shapesize(outline=8)\n"
">>> turtle.shapesize()\n"
"(5, 5, 8)"
msgstr ""
">>> turtle.shapesize()\n"
"(1.0, 1.0, 1)\n"
">>> turtle.resizemode(\"user\")\n"
">>> turtle.shapesize(5, 5, 12)\n"
">>> turtle.shapesize()\n"
"(5, 5, 12)\n"
">>> turtle.shapesize(outline=8)\n"
">>> turtle.shapesize()\n"
"(5, 5, 8)"

#: ../../library/turtle.rst:1292
msgid ""
"Return or set the current shear factor. Shearing slants the turtle shape, "
"like the slant of italic letters. The shear factor says how much it is "
"slanted: 0 is not slanted at all, and the larger the number, the stronger "
"the slant. Negative numbers slant the other way. If *shear* is not given, "
"return the current shear factor. Otherwise slant the turtle shape "
"accordingly and set resizemode to \"user\". The turtle's heading does not "
"change. Precisely, the shear factor is the tangent of the shear angle."
msgstr ""

#: ../../library/turtle.rst:1300
msgid ""
">>> turtle.shape(\"circle\")\n"
">>> turtle.shapesize(5,2)\n"
">>> turtle.shearfactor(0.5)\n"
">>> turtle.shearfactor()\n"
"0.5"
msgstr ""
">>> turtle.shape(\"circle\")\n"
">>> turtle.shapesize(5,2)\n"
">>> turtle.shearfactor(0.5)\n"
">>> turtle.shearfactor()\n"
"0.5"

#: ../../library/turtle.rst:1314
msgid ""
"Turn the turtle shape by *angle* from its current tilt angle. The turtle's "
"heading does not change, so the turtle keeps moving in the same direction. "
"See :func:`tiltangle`."
msgstr ""

#: ../../library/turtle.rst:1318
msgid ""
">>> turtle.reset()\n"
">>> turtle.shape(\"circle\")\n"
">>> turtle.shapesize(5,2)\n"
">>> turtle.tilt(30)\n"
">>> turtle.fd(50)\n"
">>> turtle.tilt(30)\n"
">>> turtle.fd(50)"
msgstr ""
">>> turtle.reset()\n"
">>> turtle.shape(\"circle\")\n"
">>> turtle.shapesize(5,2)\n"
">>> turtle.tilt(30)\n"
">>> turtle.fd(50)\n"
">>> turtle.tilt(30)\n"
">>> turtle.fd(50)"

#: ../../library/turtle.rst:1334
msgid ""
"Return or set the current tilt angle. The tilt angle is the angle between "
"the direction the turtle shape points in and the direction the turtle moves "
"in. Normally the shape points in the direction of movement, so the tilt "
"angle is 0. If *angle* is given, turn the turtle shape to that tilt angle, "
"no matter what it was before, and set resizemode to \"user\". The turtle's "
"heading does not change. If *angle* is not given, return the current tilt "
"angle."
msgstr ""

#: ../../library/turtle.rst:1342
msgid ""
">>> turtle.reset()\n"
">>> turtle.shape(\"circle\")\n"
">>> turtle.shapesize(5,2)\n"
">>> turtle.tilt(45)\n"
">>> turtle.tiltangle()\n"
"45.0"
msgstr ""
">>> turtle.reset()\n"
">>> turtle.shape(\"circle\")\n"
">>> turtle.shapesize(5,2)\n"
">>> turtle.tilt(45)\n"
">>> turtle.tiltangle()\n"
"45.0"

#: ../../library/turtle.rst:1360
msgid ""
"Return or set the transformation matrix of the turtle shape. The matrix "
"combines the stretch factors, the shear factor and the tilt angle of the "
"turtle shape into four numbers: *t11* and *t12* form its first row, *t21* "
"and *t22* its second. If none of them are given, return the current matrix "
"as a tuple of four numbers. Otherwise set the given elements and update the "
"stretch factors, shear factor and tilt angle accordingly. ``t11 * t22 - t12 "
"* t21`` must not be zero, otherwise an error is raised."
msgstr ""

#: ../../library/turtle.rst:1368
msgid ""
">>> turtle = Turtle()\n"
">>> turtle.shape(\"square\")\n"
">>> turtle.shapesize(4,2)\n"
">>> turtle.shearfactor(-0.5)\n"
">>> turtle.shapetransform()\n"
"(4.0, -1.0, -0.0, 2.0)"
msgstr ""
">>> turtle = Turtle()\n"
">>> turtle.shape(\"square\")\n"
">>> turtle.shapesize(4,2)\n"
">>> turtle.shearfactor(-0.5)\n"
">>> turtle.shapetransform()\n"
"(4.0, -1.0, -0.0, 2.0)"

#: ../../library/turtle.rst:1381
msgid ""
"Return the points that form the outline of the current turtle shape as a "
"tuple of ``(x, y)`` coordinate pairs. These points can be used to define a "
"new shape or parts of a :ref:`compound shape <compound-shapes>`"
msgstr ""

#: ../../library/turtle.rst:1385
msgid ""
">>> turtle.shape(\"square\")\n"
">>> turtle.shapetransform(4, -1, 0, 2)\n"
">>> turtle.get_shapepoly()\n"
"((50, -20), (30, 20), (-50, 20), (-30, -20))"
msgstr ""
">>> turtle.shape(\"square\")\n"
">>> turtle.shapetransform(4, -1, 0, 2)\n"
">>> turtle.get_shapepoly()\n"
"((50, -20), (30, 20), (-50, 20), (-30, -20))"

#: ../../library/turtle.rst:1395
msgid "Using events"
msgstr "Eventos Utilizados"

#: ../../library/turtle.rst:1400 ../../library/turtle.rst:1900
msgid "a function with two arguments or ``None``"
msgstr ""

#: ../../library/turtle.rst:1402 ../../library/turtle.rst:1902
msgid "a boolean or ``None``"
msgstr ""

#: ../../library/turtle.rst:1404
msgid ""
"Bind *fun* to mouse-click events on this turtle. *fun* is called with the "
"coordinates of the clicked point on the canvas. If *fun* is ``None``, "
"existing bindings are removed. *btn* is the number of the mouse button and "
"defaults to 1, the left mouse button. If *add* is ``True``, a new binding is "
"added, otherwise it replaces a former binding. Example for the anonymous "
"turtle, that is, the procedural way:"
msgstr ""

#: ../../library/turtle.rst:1411
msgid ""
">>> def turn(x, y):\n"
"...     left(180)\n"
"...\n"
">>> onclick(turn)  # Now clicking into the turtle will turn it.\n"
">>> onclick(None)  # event-binding will be removed"
msgstr ""
">>> def turn(x, y):\n"
"...     left(180)\n"
"...\n"
">>> onclick(turn)  # Agora, clicar na tartaruga irá girá-la.\n"
">>> onclick(None)  # a associação de eventos será removida"

#: ../../library/turtle.rst:1423 ../../library/turtle.rst:1448
msgid ""
"a function with two arguments which will be called with the coordinates of "
"the clicked point on the canvas"
msgstr ""
"um função com dois argumento que serão chamados com as coordenadas do ponto "
"clicado na tela"

#: ../../library/turtle.rst:1425 ../../library/turtle.rst:1450
msgid "number of the mouse-button, defaults to 1 (left mouse button)"
msgstr "número do botão do mouse, o padrão é 1 (botão esquerdo do mouse)"

#: ../../library/turtle.rst:1426 ../../library/turtle.rst:1451
msgid ""
"``True`` or ``False`` -- if ``True``, a new binding will be added, otherwise "
"it will replace a former binding"
msgstr ""
"``True`` ou ``False`` -- se ``True``, uma nova ligação será adicionada; caso "
"contrário, ela substituirá uma ligação antiga"

#: ../../library/turtle.rst:1429
msgid ""
"Bind *fun* to mouse-button-release events on this turtle.  If *fun* is "
"``None``, existing bindings are removed."
msgstr ""
"Vincule *fun* aos eventos de liberação do botão do mouse nesta tartaruga.  "
"Se *fun* for ``None``, as associações existentes serão removidas."

#: ../../library/turtle.rst:1432
msgid ""
">>> class MyTurtle(Turtle):\n"
"...     def glow(self,x,y):\n"
"...         self.fillcolor(\"red\")\n"
"...     def unglow(self,x,y):\n"
"...         self.fillcolor(\"\")\n"
"...\n"
">>> turtle = MyTurtle()\n"
">>> turtle.onclick(turtle.glow)     # clicking on turtle turns fillcolor "
"red,\n"
">>> turtle.onrelease(turtle.unglow) # releasing turns it to transparent."
msgstr ""
">>> class MyTurtle(Turtle):\n"
"...     def glow(self,x,y):\n"
"...         self.fillcolor(\"red\")\n"
"...     def unglow(self,x,y):\n"
"...         self.fillcolor(\"\")\n"
"...\n"
">>> turtle = MyTurtle()\n"
">>> turtle.onclick(turtle.glow)     # clicar na tartaruga torna o "
"preenchimento vermelho,\n"
">>> turtle.onrelease(turtle.unglow) # .liberar a transforma em transparente"

#: ../../library/turtle.rst:1454
msgid ""
"Bind *fun* to mouse-move events on this turtle.  If *fun* is ``None``, "
"existing bindings are removed."
msgstr ""
"Vincule *fun* a eventos de movimentação do mouse nessa tartaruga.  Se *fun* "
"for ``None``, as associações existentes serão removidas."

#: ../../library/turtle.rst:1457
msgid ""
"Remark: Every sequence of mouse-move-events on a turtle is preceded by a "
"mouse-click event on that turtle."
msgstr ""
"Observação: Cada sequência de eventos de movimento do mouse em uma tartaruga "
"é precedida por um evento de clique do mouse naquela tartaruga."

#: ../../library/turtle.rst:1460
msgid ">>> turtle.ondrag(turtle.goto)"
msgstr ">>> turtle.ondrag(turtle.goto)"

#: ../../library/turtle.rst:1465
msgid ""
"Subsequently, clicking and dragging the Turtle will move it across the "
"screen thereby producing handdrawings (if pen is down)."
msgstr ""
"Posteriormente, clicar e arrastar a Tartaruga a moverá pela tela, produzindo "
"desenhos à mão (se a caneta estiver deitada)."

#: ../../library/turtle.rst:1470
msgid "Special Turtle methods"
msgstr "Métodos Especiais da Tartaruga"

#: ../../library/turtle.rst:1474
msgid ""
"Record the vertices of a polygon drawn in the :keyword:`with` block. The "
"first and last vertices will be connected."
msgstr ""

#: ../../library/turtle.rst:1477
msgid ""
">>> with turtle.poly():\n"
"...     turtle.forward(100)\n"
"...     turtle.right(60)\n"
"...     turtle.forward(100)"
msgstr ""
">>> with turtle.poly():\n"
"...     turtle.forward(100)\n"
"...     turtle.right(60)\n"
"...     turtle.forward(100)"

#: ../../library/turtle.rst:1485
msgid ""
":func:`poly` is a :term:`context manager`, so using it is the same as "
"calling :func:`begin_poly` before the block and :func:`end_poly` after it:"
msgstr ""

#: ../../library/turtle.rst:1488
msgid ""
">>> turtle.begin_poly()\n"
">>> turtle.forward(100)\n"
">>> turtle.right(60)\n"
">>> turtle.forward(100)\n"
">>> turtle.end_poly()"
msgstr ""

#: ../../library/turtle.rst:1502
msgid ""
"Start recording the vertices of a polygon. The current turtle position is "
"the first vertex of the polygon."
msgstr ""

#: ../../library/turtle.rst:1508
msgid ""
"Stop recording the vertices of a polygon. The current turtle position is the "
"last vertex of the polygon. This will be connected with the first vertex."
msgstr ""

#: ../../library/turtle.rst:1514
msgid "Return the last recorded polygon."
msgstr "Retorna o último polígono registrado."

#: ../../library/turtle.rst:1516
msgid ""
">>> turtle.home()\n"
">>> turtle.begin_poly()\n"
">>> turtle.fd(100)\n"
">>> turtle.left(20)\n"
">>> turtle.fd(30)\n"
">>> turtle.left(60)\n"
">>> turtle.fd(50)\n"
">>> turtle.end_poly()\n"
">>> p = turtle.get_poly()\n"
">>> register_shape(\"myFavouriteShape\", p)"
msgstr ""
">>> turtle.home()\n"
">>> turtle.begin_poly()\n"
">>> turtle.fd(100)\n"
">>> turtle.left(20)\n"
">>> turtle.fd(30)\n"
">>> turtle.left(60)\n"
">>> turtle.fd(50)\n"
">>> turtle.end_poly()\n"
">>> p = turtle.get_poly()\n"
">>> register_shape(\"myFavouriteShape\", p)"

#: ../../library/turtle.rst:1533
msgid ""
"Create and return a clone of the turtle. The clone has the same position, "
"heading and turtle properties."
msgstr ""

#: ../../library/turtle.rst:1536
msgid ""
">>> leonel = Turtle()\n"
">>> marco = leonel.clone()"
msgstr ""

#: ../../library/turtle.rst:1546
msgid "Return the Turtle object itself."
msgstr ""

#: ../../library/turtle.rst:1548
msgid ""
"Call ``getturtle()`` to get the turtle used by functions such "
"as :func:`forward` and :func:`left`:"
msgstr ""

#: ../../library/turtle.rst:1551
msgid ""
">>> pet = getturtle()\n"
">>> pet.fd(50)\n"
">>> pet\n"
"<turtle.Turtle object at 0x...>"
msgstr ""
">>> pet = getturtle()\n"
">>> pet.fd(50)\n"
">>> pet\n"
"<turtle.Turtle object at 0x...>"

#: ../../library/turtle.rst:1562
msgid ""
"Return the :class:`TurtleScreen` object the turtle is drawing on. "
"TurtleScreen methods can then be called for that object."
msgstr ""
"Retorna o objeto :class:`TurtleScreen` no qual a tartaruga está sendo "
"desenhada. Os métodos de TurtleScreen podem então ser chamados para este "
"objeto."

#: ../../library/turtle.rst:1565
msgid ""
">>> ts = turtle.getscreen()\n"
">>> ts\n"
"<turtle._Screen object at 0x...>\n"
">>> ts.bgcolor(\"pink\")"
msgstr ""
">>> ts = turtle.getscreen()\n"
">>> ts\n"
"<turtle._Screen object at 0x...>\n"
">>> ts.bgcolor(\"pink\")"

#: ../../library/turtle.rst:1578
msgid ""
"Set or disable the undo buffer. If *size* is an integer, an empty undo "
"buffer of the given size is installed. *size* is the maximum number of "
"turtle actions that can be undone by :func:`undo`. If *size* is ``None``, "
"the undo buffer is disabled."
msgstr ""

#: ../../library/turtle.rst:1583
msgid ">>> turtle.setundobuffer(42)"
msgstr ">>> turtle.setundobuffer(42)"

#: ../../library/turtle.rst:1591
msgid "Return the number of entries in the undo buffer."
msgstr ""

#: ../../library/turtle.rst:1593
msgid ""
">>> while undobufferentries():\n"
"...     undo()"
msgstr ""
">>> while undobufferentries():\n"
"...     undo()"

#: ../../library/turtle.rst:1604
msgid "Screen methods and functions"
msgstr "Métodos e funções de janela"

#: ../../library/turtle.rst:1606
msgid ""
"Most of the examples in this section refer to a TurtleScreen instance called "
"``screen``."
msgstr ""
"A maioria dos exemplos desta seção se refere a uma instância de TurtleScreen "
"chamada ``screen``."

#: ../../library/turtle.rst:1617
msgid "Window control"
msgstr "Controle da Janela"

#: ../../library/turtle.rst:1623
msgid "Return or set the background color of the TurtleScreen."
msgstr "Retorna ou define a cor de fundo do TurtleScreen."

#: ../../library/turtle.rst:1627
msgid "``bgcolor()``"
msgstr "``bgcolor()``"

#: ../../library/turtle.rst:1628
msgid ""
"Return the current background color as a color specification string or as a "
"tuple (see example).  May be used as input to "
"another :func:`color`, :func:`pencolor`, :func:`fillcolor` "
"or :func:`bgcolor` call."
msgstr ""

#: ../../library/turtle.rst:1633
msgid "``bgcolor(colorstring)``"
msgstr "``bgcolor(colorstring)``"

#: ../../library/turtle.rst:1634
msgid ""
"Set the background color to *colorstring*, which is a Tk color specification "
"string, such as ``\"red\"``, ``\"yellow\"``, or ``\"#33cc8c\"``."
msgstr ""
"Define a cor de fundo como *colorstring*, que é uma string de especificação "
"de cor Tk, como ``\"red\"``, ``\"yellow\"`` ou ``\"#33cc8c\"``."

#: ../../library/turtle.rst:1637
msgid "``bgcolor((r, g, b))``"
msgstr "``bgcolor((r, g, b))``"

#: ../../library/turtle.rst:1638
msgid ""
"Set the background color to the RGB color represented by the tuple of *r*, "
"*g*, and *b*. Each of *r*, *g*, and *b* must be between 0 and colormode, "
"where colormode is either 1.0 or 255 (see :func:`colormode`)."
msgstr ""

#: ../../library/turtle.rst:1643
msgid "``bgcolor(r, g, b)``"
msgstr "``bgcolor(r, g, b)``"

#: ../../library/turtle.rst:1644
msgid ""
"Set the background color to the RGB color represented by *r*, *g*, and *b*. "
"Each of *r*, *g*, and *b* must be between 0 and colormode."
msgstr ""

#: ../../library/turtle.rst:1647
msgid ""
">>> screen.bgcolor(\"orange\")\n"
">>> screen.bgcolor()\n"
"'orange'\n"
">>> screen.bgcolor(\"#800080\")\n"
">>> screen.bgcolor()\n"
"(128.0, 0.0, 128.0)"
msgstr ""
">>> screen.bgcolor(\"orange\")\n"
">>> screen.bgcolor()\n"
"'orange'\n"
">>> screen.bgcolor(\"#800080\")\n"
">>> screen.bgcolor()\n"
"(128.0, 0.0, 128.0)"

#: ../../library/turtle.rst:1662
msgid ""
"Set the background image or return the name of the current one. If *picname* "
"is the name of an image file (PNG, GIF, PGM, and PPM), set that image as the "
"background. If *picname* is ``\"nopic\"``, delete the background image, if "
"present. If *picname* is ``None``, return the filename of the current "
"background image. ::"
msgstr ""

#: ../../library/turtle.rst:1668
msgid ""
">>> screen.bgpic()\n"
"'nopic'\n"
">>> screen.bgpic(\"landscape.gif\")\n"
">>> screen.bgpic()\n"
"'landscape.gif'"
msgstr ""

#: ../../library/turtle.rst:1679
msgid ""
"This TurtleScreen method is available as a global function only under the "
"name ``clearscreen``.  The global function ``clear`` is a different one "
"derived from the Turtle method ``clear``."
msgstr ""
"Este método de TurtleScreen está disponível como uma função global somente "
"sob o nome ``clearscreen``. A função global ``clear`` é derivada de forma "
"diferente do método de Turtle ``clear`` ."

#: ../../library/turtle.rst:1686
msgid ""
"Delete all drawings and all turtles from the TurtleScreen.  Reset the now "
"empty TurtleScreen to its initial state: white background, no background "
"image, no event bindings and tracing on."
msgstr ""
"Remove todos os desenhos e todas as tartarugas da TurtleScreen. Redefine a "
"TurtleScreen, agora vazia, para seu estado inicial: fundo branco, sem imagem "
"de fundo, sem vínculos de eventos e rastreamento ativado."

#: ../../library/turtle.rst:1695
msgid ""
"This TurtleScreen method is available as a global function only under the "
"name ``resetscreen``.  The global function ``reset`` is another one derived "
"from the Turtle method ``reset``."
msgstr ""
"Este método de TurtleScreen está disponível como uma função global somente "
"com o nome ``resetscreen``. A função global ``reset`` é outra derivada do "
"método de Turtle ``reset`` ."

#: ../../library/turtle.rst:1702
msgid "Reset all turtles on the screen to their initial state."
msgstr ""

#: ../../library/turtle.rst:1709
msgid "a colorstring or a color tuple or ``None``"
msgstr ""

#: ../../library/turtle.rst:1711
msgid ""
"Resize the canvas the turtles are drawing on. *canvwidth* and *canvheight* "
"are the new width and height of the canvas in pixels, and *bg* is the new "
"background color. If no arguments are given, return the current canvas width "
"and height."
msgstr ""

#: ../../library/turtle.rst:1716
msgid ""
"The drawing window is not altered. To see hidden parts of the canvas, use "
"the scrollbars. This can make visible those parts of a drawing which were "
"outside the canvas before, for example to find a turtle that has wandered "
"off the canvas."
msgstr ""

#: ../../library/turtle.rst:1721
msgid ""
">>> screen.screensize()\n"
"(400, 300)\n"
">>> screen.screensize(2000,1500)\n"
">>> screen.screensize()\n"
"(2000, 1500)"
msgstr ""
">>> screen.screensize()\n"
"(400, 300)\n"
">>> screen.screensize(2000,1500)\n"
">>> screen.screensize()\n"
"(2000, 1500)"

#: ../../library/turtle.rst:1738
msgid ""
"Set up a user-defined coordinate system. *llx* and *lly* are the x and y "
"coordinates of the lower left corner of the canvas. *urx* and *ury* are the "
"x and y coordinates of the upper right corner. Switch to mode \"world\" if "
"necessary, which performs a reset. If mode \"world\" is already active, all "
"drawings are redrawn according to the new coordinates. In user-defined "
"coordinate systems, angles may appear distorted, see :func:`mode`."
msgstr ""

#: ../../library/turtle.rst:1745
msgid ""
">>> screen.reset()\n"
">>> screen.setworldcoordinates(-50,-7.5,50,7.5)\n"
">>> for _ in range(72):\n"
"...     left(10)\n"
"...\n"
">>> for _ in range(8):\n"
"...     left(45); fd(2)   # a regular octagon"
msgstr ""
">>> screen.reset()\n"
">>> screen.setworldcoordinates(-50,-7.5,50,7.5)\n"
">>> for _ in range(72):\n"
"...     left(10)\n"
"...\n"
">>> for _ in range(8):\n"
"...     left(45); fd(2)   # a regular octagon"

#: ../../library/turtle.rst:1766
msgid "Animation control"
msgstr "Controle da animação"

#: ../../library/turtle.rst:1770
msgid ""
"Temporarily turn off turtle animation. The code inside the :keyword:`with` "
"block is not animated. Once the block is exited, the drawing appears. This "
"is useful for drawing complex shapes where even the fastest speed setting is "
"too slow."
msgstr ""

#: ../../library/turtle.rst:1775
msgid ""
">>> with screen.no_animation():\n"
"...     for dist in range(2, 400, 2):\n"
"...         fd(dist)\n"
"...         rt(90)"
msgstr ""
">>> with screen.no_animation():\n"
"...     for dist in range(2, 400, 2):\n"
"...         fd(dist)\n"
"...         rt(90)"

#: ../../library/turtle.rst:1788 ../../library/turtle.rst:1806
#: ../../library/turtle.rst:1807
msgid "a nonnegative integer or ``None``"
msgstr ""

#: ../../library/turtle.rst:1790
msgid ""
"Return or set the drawing delay in milliseconds. This is approximately the "
"time interval between two consecutive canvas updates. The longer the drawing "
"delay, the slower the animation."
msgstr ""

#: ../../library/turtle.rst:1794
msgid ""
">>> screen.delay()\n"
"10\n"
">>> screen.delay(5)\n"
">>> screen.delay()\n"
"5"
msgstr ""
">>> screen.delay()\n"
"10\n"
">>> screen.delay(5)\n"
">>> screen.delay()\n"
"5"

#: ../../library/turtle.rst:1809
msgid ""
"Turn turtle animation on or off and set the drawing delay. If *n* is given, "
"only every n-th regular screen update is performed, which can be used to "
"speed up the drawing of complex graphics. If *n* is 0, animation is turned "
"off and the screen is only updated by calling :func:`update`. If *delay* is "
"given, it sets the drawing delay, see :func:`delay`. When called without "
"arguments, return the current value of *n*."
msgstr ""

#: ../../library/turtle.rst:1816
msgid ""
">>> screen.tracer(8, 25)\n"
">>> dist = 2\n"
">>> for i in range(200):\n"
"...     fd(dist)\n"
"...     rt(90)\n"
"...     dist += 2"
msgstr ""
">>> screen.tracer(8, 25)\n"
">>> dist = 2\n"
">>> for i in range(200):\n"
"...     fd(dist)\n"
"...     rt(90)\n"
"...     dist += 2"

#: ../../library/turtle.rst:1829
msgid "Perform a TurtleScreen update. To be used when tracer is turned off."
msgstr ""
"Executa uma atualização do TurtleScreen. Para ser usado quando o rastreador "
"estiver desligado."

#: ../../library/turtle.rst:1831
msgid "See also the RawTurtle/Turtle method :func:`speed`."
msgstr "Veja também o método RawTurtle/Turtle :func:`speed`."

#: ../../library/turtle.rst:1835
msgid "Using screen events"
msgstr "Usando os eventos de tela"

#: ../../library/turtle.rst:1839 ../../library/turtle.rst:1840
msgid "ignored"
msgstr ""

#: ../../library/turtle.rst:1842
msgid ""
"Set focus on the :class:`TurtleScreen` so that it receives key events. The "
"two dummy arguments are only there so that :func:`listen` can be passed "
"to :func:`onclick`."
msgstr ""

#: ../../library/turtle.rst:1850 ../../library/turtle.rst:1874
msgid "a function with no arguments or ``None``"
msgstr "uma função sem argumentos ou ``None``"

#: ../../library/turtle.rst:1853
msgid ""
"Bind *fun* to the key-release event of *key*. *key* is a key, such as \"a\", "
"or a key symbol, such as \"space\". If *fun* is ``None``, the event binding "
"is removed. To be able to receive key events, the :class:`TurtleScreen` must "
"have focus, see :func:`listen`."
msgstr ""

#: ../../library/turtle.rst:1858
msgid ""
">>> def f():\n"
"...     fd(50)\n"
"...     lt(60)\n"
"...\n"
">>> screen.onkey(f, \"Up\")\n"
">>> screen.listen()"
msgstr ""
">>> def f():\n"
"...     fd(50)\n"
"...     lt(60)\n"
"...\n"
">>> screen.onkey(f, \"Up\")\n"
">>> screen.listen()"

#: ../../library/turtle.rst:1868
msgid ""
"The turtle can then be moved by repeatedly pressing the up-arrow key, "
"drawing a hexagon."
msgstr ""

#: ../../library/turtle.rst:1877
msgid ""
"Bind *fun* to the key-press event of *key*. *key* is a key, such as \"a\", "
"or a key symbol, such as \"space\". If *key* is not given, *fun* is bound to "
"the key-press event of any key. If *fun* is ``None``, the event binding is "
"removed. To be able to receive key events, the :class:`TurtleScreen` must "
"have focus, see :func:`listen`."
msgstr ""

#: ../../library/turtle.rst:1883
msgid ""
">>> def f():\n"
"...     fd(50)\n"
"...     lt(60)\n"
"...\n"
">>> screen.onkeypress(f, \"Up\")\n"
">>> screen.listen()"
msgstr ""

#: ../../library/turtle.rst:1893
msgid ""
"The turtle can then be moved by pressing or holding down the up-arrow key, "
"drawing a hexagon."
msgstr ""

#: ../../library/turtle.rst:1904
msgid ""
"Bind *fun* to mouse-click events on this screen. *fun* is called with the "
"coordinates of the clicked point on the canvas. If *fun* is ``None``, "
"existing bindings are removed. *btn* is the number of the mouse button and "
"defaults to 1, the left mouse button. If *add* is ``True``, a new binding is "
"added, otherwise it replaces a former binding."
msgstr ""

#: ../../library/turtle.rst:1910
msgid ""
"Example for a TurtleScreen instance named ``screen`` and a Turtle instance "
"named ``turtle``:"
msgstr ""
"Exemplo de uma instância de TurtleScreen chamada ``screen`` e uma instância "
"de Turtle chamada ``turtle``:"

#: ../../library/turtle.rst:1913
msgid ""
">>> screen.onclick(turtle.goto) # Subsequently clicking into the "
"TurtleScreen will\n"
">>>                             # make the turtle move to the clicked "
"point.\n"
">>> screen.onclick(None)        # remove event binding again"
msgstr ""
">>> screen.onclick(turtle.goto) # Em seguida, clicar no TurtleScreen\n"
">>>                             # fará a tartaruga se mover até o ponto "
"clicado.\n"
">>> screen.onclick(None)        # remove associação de evento novamente"

#: ../../library/turtle.rst:1921
msgid ""
"This TurtleScreen method is available as a global function only under the "
"name ``onscreenclick``.  The global function ``onclick`` is another one "
"derived from the Turtle method ``onclick``."
msgstr ""
"Este método TurtleScreen está disponível como uma função global somente com "
"o nome ``onscreenclick``. A função global ``onclick`` é outra derivada do "
"método de Turtle ``onclick`` ."

#: ../../library/turtle.rst:1928
msgid "a function with no arguments"
msgstr "um função sem nenhum argumento"

#: ../../library/turtle.rst:1929
msgid "a nonnegative number"
msgstr ""

#: ../../library/turtle.rst:1931
msgid "Install a timer that calls *fun* after *t* milliseconds."
msgstr "Instala um cronômetro que chama *fun* após *t* milissegundos."

#: ../../library/turtle.rst:1933
msgid ""
">>> running = True\n"
">>> def f():\n"
"...     if running:\n"
"...         fd(50)\n"
"...         lt(60)\n"
"...         screen.ontimer(f, 250)\n"
">>> f()  # makes the turtle march around\n"
">>> running = False"
msgstr ""

#: ../../library/turtle.rst:1949
msgid ""
"Start the event loop by calling Tkinter's :meth:`~tkinter.Misc.mainloop` "
"method. Must be the last statement in a turtle graphics program. Must *not* "
"be used if a script is run from within IDLE in -n mode (see :ref:`idle-no-"
"subprocess`)."
msgstr ""

#: ../../library/turtle.rst:1956
msgid "Input methods"
msgstr "Métodos de entrada"

#: ../../library/turtle.rst:1963
msgid ""
"Pop up a dialog window for input of a string. *title* is the title of the "
"dialog window and *prompt* is a text describing what information to input. "
"Return the string entered. If the dialog is canceled, return ``None``. ::"
msgstr ""

#: ../../library/turtle.rst:1967
msgid ">>> screen.textinput(\"NIM\", \"Name of first player:\")"
msgstr ">>> screen.textinput(\"NIM\", \"Name of first player:\")"

#: ../../library/turtle.rst:1978
msgid ""
"Pop up a dialog window for input of a number. *title* is the title of the "
"dialog window and *prompt* is a text describing what numerical information "
"to input. *default* is the default value, *minval* and *maxval* are the "
"minimum and maximum values for input. If these are given, the number entered "
"must be between *minval* and *maxval*. If not, a hint is issued and the "
"dialog remains open for correction. Return the number entered. If the dialog "
"is canceled, return ``None``. ::"
msgstr ""

#: ../../library/turtle.rst:1986
msgid ""
">>> screen.numinput(\"Poker\", \"Your stakes:\", 1000, minval=10, "
"maxval=10000)"
msgstr ""
">>> screen.numinput(\"Poker\", \"Your stakes:\", 1000, minval=10, "
"maxval=10000)"

#: ../../library/turtle.rst:1990
msgid "Settings and special methods"
msgstr "Configurações e métodos especiais"

#: ../../library/turtle.rst:1996
msgid ""
"Set the turtle mode and perform a reset. *mode* is one of the strings "
"\"standard\", \"logo\" or \"world\". If *mode* is not given, return the "
"current mode."
msgstr ""

#: ../../library/turtle.rst:2000
msgid ""
"Mode \"standard\" is compatible with the old :mod:`!turtle` module. Mode "
"\"logo\" is compatible with most Logo turtle graphics. Mode \"world\" uses "
"user-defined world coordinates, see :func:`setworldcoordinates`. In this "
"mode, angles appear distorted if the x and y units are not of equal length."
msgstr ""

#: ../../library/turtle.rst:2006
msgid "Mode"
msgstr "Modo"

#: ../../library/turtle.rst:2006
msgid "Initial turtle heading"
msgstr "Título inicial da tartaruga"

#: ../../library/turtle.rst:2006
msgid "positive angles"
msgstr "ângulos positivos"

#: ../../library/turtle.rst:2008
msgid "\"standard\""
msgstr "\"standard\""

#: ../../library/turtle.rst:2008
msgid "to the right (east)"
msgstr "para a direita (east)"

#: ../../library/turtle.rst:2008
msgid "counterclockwise"
msgstr "counterclockwise"

#: ../../library/turtle.rst:2009
msgid "\"logo\""
msgstr "\"logo\""

#: ../../library/turtle.rst:2009
msgid "upward    (north)"
msgstr "upward (north)"

#: ../../library/turtle.rst:2009
msgid "clockwise"
msgstr "sentido horário"

#: ../../library/turtle.rst:2012
msgid ""
">>> mode(\"logo\")  # resets turtle heading to north\n"
">>> mode()\n"
"'logo'"
msgstr ""

#: ../../library/turtle.rst:2024
msgid ""
"Return the colormode or set it to 1.0 or 255. After setting it, the *r*, *g* "
"and *b* values of color triples have to be between 0 and *cmode*."
msgstr ""

#: ../../library/turtle.rst:2027
msgid ""
">>> screen.colormode(1)\n"
">>> turtle.pencolor(240, 160, 80)\n"
"Traceback (most recent call last):\n"
"     ...\n"
"TurtleGraphicsError: bad color sequence: (240, 160, 80)\n"
">>> screen.colormode()\n"
"1.0\n"
">>> screen.colormode(255)\n"
">>> screen.colormode()\n"
"255\n"
">>> turtle.pencolor(240,160,80)"
msgstr ""
">>> screen.colormode(1)\n"
">>> turtle.pencolor(240, 160, 80)\n"
"Traceback (most recent call last):\n"
"     ...\n"
"TurtleGraphicsError: bad color sequence: (240, 160, 80)\n"
">>> screen.colormode()\n"
"1.0\n"
">>> screen.colormode(255)\n"
">>> screen.colormode()\n"
"255\n"
">>> turtle.pencolor(240,160,80)"

#: ../../library/turtle.rst:2045
msgid ""
"Return the Canvas of this TurtleScreen.  Useful for insiders who know what "
"to do with a Tkinter Canvas."
msgstr ""
"Retorna a tela desse TurtleScreen.  Útil para pessoas que sabem o que fazer "
"com uma tela do Tkinter."

#: ../../library/turtle.rst:2048
msgid ""
">>> cv = screen.getcanvas()\n"
">>> cv\n"
"<turtle.ScrolledCanvas object ...>"
msgstr ""
">>> cv = screen.getcanvas()\n"
">>> cv\n"
"<turtle.ScrolledCanvas object ...>"

#: ../../library/turtle.rst:2058
msgid "Return a list of names of all currently available turtle shapes."
msgstr ""
"Retorna uma lista dos nomes de todas as formas de tartarugas disponíveis no "
"momento."

#: ../../library/turtle.rst:2060
msgid ""
">>> screen.getshapes()\n"
"['arrow', 'blank', 'circle', ..., 'turtle']"
msgstr ""
">>> screen.getshapes()\n"
"['arrow', 'blank', 'circle', ..., 'turtle']"

