msgstr ""
"Define a direção da tartaruga para *to_angle*. Aqui estão algumas direções "
"mais comuns em graus:"

#: ../../library/turtle.rst:446
msgid "standard mode"
msgstr "modo padrão"

#: ../../library/turtle.rst:446
msgid "logo mode"
msgstr "modo logo"

#: ../../library/turtle.rst:448
msgid "0 - east"
msgstr "0 - leste"

#: ../../library/turtle.rst:448
msgid "0 - north"
msgstr "0 - norte"

#: ../../library/turtle.rst:449
msgid "90 - north"
msgstr "90 - norte"

#: ../../library/turtle.rst:449
msgid "90 - east"
msgstr "90 - leste"

#: ../../library/turtle.rst:450
msgid "180 - west"
msgstr "180 - oeste"

