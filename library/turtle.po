#: ../../library/turtle.rst:2183
msgid "a color the *poly* will be filled with"
msgstr "uma cor com a qual o *poly* será preenchido"

#: ../../library/turtle.rst:2184
msgid "a color for the poly's outline (if given)"
msgstr "uma cor para o contorno do polígono (se fornecido)"

#: ../../library/turtle.rst:2186
msgid "Example:"
msgstr "Exemplo:"

#: ../../library/turtle.rst:2188
msgid ""
">>> poly = ((0,0),(10,-5),(0,10),(-10,-5))\n"
">>> s = Shape(\"compound\")\n"
">>> s.addcomponent(poly, \"red\", \"blue\")\n"
">>> # ... add more components and then use register_shape()"
msgstr ""
">>> poly = ((0,0),(10,-5),(0,10),(-10,-5))\n"
">>> s = Shape(\"compound\")\n"
">>> s.addcomponent(poly, \"red\", \"blue\")\n"
">>> # ... adicione mais componentes e então use register_shape()"

#: ../../library/turtle.rst:2196
msgid "See :ref:`compoundshapes`."
msgstr "Veja :ref:`compoundshapes`."

#: ../../library/turtle.rst:2201
