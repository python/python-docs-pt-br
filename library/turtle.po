#: ../../library/turtle.rst:124 ../../library/turtle.rst:810
msgid "Pen control"
msgstr "Controle da Caneta"

#: ../../library/turtle.rst:126
msgid ""
"Try changing the color - for example, ``color('blue')`` - and width of the "
